rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasAll(['message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt is string
        && (!('name' in request.resource.data) || (
          request.resource.data.name is string
          && request.resource.data.name.size() <= 120
        ))
        && (!('email' in request.resource.data) || (
          request.resource.data.email is string
          && request.resource.data.email.size() <= 254
        ))
        && (!('userId' in request.resource.data) || (
          request.resource.data.userId is string
          && request.resource.data.userId.size() <= 128
        ));
      allow read, update, delete: if false;
    }

    match /assignments/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll([
          'title', 'introduction', 'body', 'conclusion', 'references', 'includeCover', 'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.introduction is string
        && request.resource.data.introduction.size() <= 80000
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 80000
        && request.resource.data.conclusion is string
        && request.resource.data.conclusion.size() <= 80000
        && request.resource.data.references is string
        && request.resource.data.references.size() <= 80000
        && request.resource.data.includeCover is bool
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }
  }
}
