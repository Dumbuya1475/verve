# --- Supabase (Issue 1 / Issue 2) ---------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only — never expose to the browser. Used for admin-level tasks
# (e.g. the webhook handler in Issue 7).
SUPABASE_SERVICE_ROLE_KEY=

# --- Monime payments (Issue 7) -------------------------------------------
# From the Monime Developer Portal (docs.monime.io).
MONIME_SPACE_ID=
MONIME_ACCESS_TOKEN=
MONIME_VERSION=
MONIME_WEBHOOK_SECRET=

# --- Gemini AI generation (Issue 5) --------------------------------------
# From Google AI Studio.
GEMINI_API_KEY=

# --- GitHub OAuth App (Issue 8) ------------------------------------------
# Register at https://github.com/settings/developers
# Callback URL: https://<yourdomain>/api/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Email delivery (Issue 9) ---------------------------------------------
RESEND_API_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
